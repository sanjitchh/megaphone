APP_NAME=Megaphone
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://megaphone.local:9443

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

OCTANE_SERVER=swoole
OCTANE_HOST=0.0.0.0
OCTANE_PORT=8000
OCTANE_WORKERS=auto
OCTANE_TASK_WORKERS=auto
OCTANE_MAX_REQUESTS=500

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Container names on the compose network (docker-compose.yml). From the host,
# MySQL is on 127.0.0.1:33064.
DB_CONNECTION=mysql
DB_HOST=megaphone-mysql
DB_PORT=3306
DB_DATABASE=megaphone
DB_USERNAME=megaphone
DB_PASSWORD=secret

SESSION_DRIVER=redis
SESSION_CONNECTION=sessions
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

REDIS_CLIENT=phpredis
REDIS_HOST=megaphone-redis
REDIS_PASSWORD=null
REDIS_PORT=6379
# 0 locks and Reverb scaling, 1 cache, 2 sessions, 3 queue and Horizon.
REDIS_QUEUE_CONNECTION=jobs
HORIZON_REDIS_CONNECTION=jobs

# Server side: the app publishes to the reverb container directly.
REVERB_APP_ID=megaphone-local
REVERB_APP_KEY=megaphone-local-key
REVERB_APP_SECRET=megaphone-local-secret
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http

# Browser side: through the edge proxy's TLS (wss://megaphone.local:9443/app).
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST=megaphone.local
VITE_REVERB_PORT=9443
VITE_REVERB_SCHEME=https

# Server-to-server room service calls go over the compose network, not the
# public wss:// host: that resolves to the edge nginx, whose self-signed dev cert
# the app container does not trust.
LIVEKIT_URL=http://livekit:7880
LIVEKIT_PUBLIC_URL=wss://megaphone.local:9443
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=megaphone-local-livekit-secret-0001
LIVEKIT_TOKEN_TTL=3600
LIVEKIT_ROOM_EMPTY_TIMEOUT=300
LIVEKIT_CONNECT_TIMEOUT=2
LIVEKIT_REQUEST_TIMEOUT=3

# The single host account created by the database seeder (config/megaphone.php).
HOST_NAME=Host
HOST_EMAIL=host@megaphone.local
HOST_PASSWORD=password

ROOMS_DEFAULT_MAX_SPEAKERS=4
ROOMS_MAX_SPEAKERS_LIMIT=8

# Mailpit (docker-compose.yml); read mail at https://mail.megaphone.local:9443.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@megaphone.local"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
